generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  brand       String
  category    String
  isNew       Boolean   @default(false)
  description String?
  variants    Variant[]
  createdAt   DateTime  @default(now())
}

model Variant {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  storageLabel String
  colourName   String
  colourHex    String
  mrpPaise     Int
  pricePaise   Int
  imageUrl     String
  isDefault    Boolean   @default(false)
  inStock      Boolean   @default(true)
  emiPlans     EmiPlan[]

  @@unique([productId, storageLabel, colourName])
}

model EmiPlan {
  id                 String  @id @default(cuid())
  variantId          String
  variant            Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  tenureMonths       Int
  annualRatePercent  Decimal @db.Decimal(5, 2)
  monthlyAmountPaise Int
  totalPayablePaise  Int
  cashbackPaise      Int     @default(0)
  isNoCost           Boolean
  displayOrder       Int

  @@unique([variantId, tenureMonths])
}

model CheckoutIntent {
  id        String   @id @default(cuid())
  reference String   @unique
  variantId String
  emiPlanId String
  status    String   @default("created")
  createdAt DateTime @default(now())
}
